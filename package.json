{
  "name": "drp-datepicker",
  "version": "1.3.0",
  "description": "drp-datepicker — Bikram Sambat (BS) ↔ Gregorian (AD) date conversion engine + a dual-calendar <drp-datepicker> Web Component. Zero dependencies, works everywhere.",
  "type": "module",
  "main": "dist/drp-datepicker.cjs.js",
  "module": "src/index.js",
  "browser": "dist/drp-datepicker.global.js",
  "unpkg": "dist/drp-datepicker.global.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/drp-datepicker.cjs.js",
      "types": "./types/index.d.ts"
    },
    "./core": {
      "import": "./src/core/nepali-calendar.js",
      "require": "./dist/drp-core.cjs.js",
      "types": "./types/nepali-calendar.d.ts"
    },
    "./datepicker": {
      "import": "./src/components/nepali-datepicker.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/smoke-test.mjs && node scripts/form-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "drp",
    "nepali",
    "bikram-sambat",
    "bs-calendar",
    "nepali-date",
    "nepali-datepicker",
    "web-component",
    "electron",
    "date-conversion",
    "dual-calendar",
    "bikram-sambat-to-gregorian",
    "nepali-calendar",
    "bs-to-ad",
    "ad-to-bs"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.21.5",
    "jsdom": "^24.0.0"
  },
  "engines": {
    "node": ">=16"
  },
  "directories": {
    "example": "examples"
  },
  "author": ""
}
